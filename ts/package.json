{
  "name": "stanwasm",
  "version": "0.7.0",
  "description": "Run models written in a subset of the Stan language entirely in the browser. An independent implementation, not a port of Stan.",
  "type": "module",
  "main": "./index.js",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./pkg/*": "./pkg/*"
  },
  "files": ["index.js", "index.d.ts", "pkg/", "LICENSE", "README.md"],
  "scripts": {
    "build:wasm": "make -C .. wasm",
    "test": "node --import tsx/esm tests/smoke.ts",
    "test:aot": "node --import tsx/esm tests/aot_smoke.ts",
    "bench": "node --import tsx/esm tests/bench.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/habakan/stanwasm.git"
  },
  "homepage": "https://github.com/habakan/stanwasm#readme",
  "keywords": ["stan", "bayesian", "mcmc", "nuts", "webassembly", "wasm"],
  "license": "Apache-2.0",
  "devDependencies": {
    "tsx": "^4.21.0"
  }
}
