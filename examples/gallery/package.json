{
  "name": "stanwasm-gallery",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "copy-wasm": "mkdir -p public && cp ../../ts/pkg/stan_wasm_api_bg.wasm public/",
    "copy-mathjax": "mkdir -p public && cp node_modules/mathjax-full/es5/tex-svg.js public/mathjax-tex-svg.js",
    "dev": "npm run copy-wasm && npm run copy-mathjax && vite",
    "build": "npm run copy-wasm && npm run copy-mathjax && tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "better-react-mathjax": "^3.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stanwasm": "file:../../ts"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.7.2",
    "vite": "^7.3.6"
  }
}
